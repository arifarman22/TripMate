NODE_ENV=production
PORT=3000

# Database - Use your production PostgreSQL URL
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

# JWT Secrets - Generate strong secrets for production
JWT_SECRET=your-production-jwt-secret-256-bits-minimum
JWT_REFRESH_SECRET=your-production-refresh-secret-256-bits-minimum
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS Origins - Add your frontend domain
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100